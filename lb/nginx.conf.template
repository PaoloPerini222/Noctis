# Balanceador: reparte entre el front (nginx) de cada nodo, que a su vez
# proxea /api/ a su propio back. JWT es stateless con el mismo secreto en los
# 3 nodos, así que no hace falta afinidad de sesión.
upstream nodos {
    least_conn;
    server ${NODO1} max_fails=3 fail_timeout=10s;
    server ${NODO2} max_fails=3 fail_timeout=10s;
    server ${NODO3} max_fails=3 fail_timeout=10s;
}

server {
    listen 80;

    location / {
        proxy_pass http://nodos;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Conexión a la base local de Docker (docker-compose.db.yml). No apunta a Supabase.
# Copiar a .env.docker: cp .env.docker.example .env.docker
# Lo usan "npm run dev:docker" del back y del front (el front toma de acá PORT y FRONTEND_URL).
PORT=3001
DB_HOST=localhost
DB_PORT=5433
DB_USER=eventos
DB_PASSWORD=eventos
DB_NAME=eventos
DB_SSL=false

# Alcanza para desarrollo local. Para algo más serio generar uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=secreto_solo_para_desarrollo_local_cambiar_si_se_expone
JWT_EXPIRES_IN=8h

FRONTEND_URL=http://localhost:5180

PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

FRONTEND_URL=http://localhost:5173


# --- Despliegue en 4 máquinas (docker-compose.app.yml / docker-compose.lb-db.yml) ---
# Nodos (x3): DB_HOST = IP de la máquina con Postgres + balanceador,
# JWT_SECRET idéntico en los 3, FRONTEND_URL = URL pública del balanceador.
# DB_HOST=192.168.1.10
# FRONTEND_URL=http://192.168.1.10
FRONT_PORT=8081
# Máquina del balanceador: ip:puerto del front de cada nodo
NODO1=192.168.1.11:8081
NODO2=192.168.1.12:8081
NODO3=192.168.1.13:8081
LB_PORT=80
